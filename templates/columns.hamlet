<h1 .title>Columns
<h2>Create new column
<form method=post action=@{ColumnsR} enctype=#{enctype}>
  ^{widget}
  <button>Create
<div .container>
  $if null columns
    <p>No columns.
  $else
    <ul .columns>
      $forall column <- columns
        <li .column>
          <h3 .column-title>
            <a href=@{ColumnR $ columnTitle column}>#{columnTitle column}
