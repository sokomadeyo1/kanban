<h1 .title>Columns

<h3>Create new column
<form method=post action=@{ColumnsR} enctype=#{enctypeCol}>
  ^{widgetCol}
  <button>Create

<div .container>
  $if null columns
    <p>No columns.
  $else
    <ul .columns>
      $forall column <- columns
        <li .column>
          <h3 .column-title>
            <a href=@{ColumnR $ columnTitle column}>#{columnTitle column}

<h2>Constraints

<h3>Create new constraint
<form method=post action=@{ConstraintR} enctype=#{enctypeConstr}>
  ^{widgetConstr}
  <button>Create

<div .container>
  $if null constraints
    <p>No constraints.
  $else
    <ul .constraints>
      $forall (from, to) <- constraints
        <li .constraint>
          <p>
            <b>#{columnTitle from}
            →
            <b>#{columnTitle to}
          <form method=post action=@{DeleteConstraintR (columnTitle from) (columnTitle to)}>
            <button>Delete
