<h1 .column-title>#{colname}

<!-- Rename form -->
<form method=post action=@{ColumnR colname} enctype=#{enctype}>
  ^{widget}
  <button> Update

<h2>Entries
<div .container>
  $if null entries
    <p>No entries.
  $else
    <ul .entries>
      $forall (entry, tags) <- entries
        <li .entry>
          <span .entry-id>#{pretty $ entryID entry}
          :
          <b .entry-title>#{entryTitle entry}
          <br>
          $forall tag <- tags
            <span .tag-name>#{tagName tag}
          <p .entry-contents>#{entryDesc entry}
          <a href=@{EntryR $ getid entry}>Edit entry
          <hr>
