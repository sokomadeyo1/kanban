<h1 .title>Board
<div .container>
  $if null entries
    <p>No entries.
  $else
    <ul .entries>
      $forall (entry, tags) <- entries
        <li .entry>
          <span .column-title>#{entryColName entry}
          <span .entry-id>#{pretty $ entryID entry}
          :
          <b .entry-title>#{entryTitle entry}
          <br>
          $forall tag <- tags
            <span .tag-name>#{tagName tag}
          <p .entry-contents>#{entryDesc entry}
