<h1 .title>Tags

<h3>Create new tag
<form method=post action=@{TagsR} enctype=#{enctype}>
  ^{widget}
  <button>Create

<div .container>
  $if null tags
    <p>No tags.
  $else
    <ul .tags>
      $forall tag <- tags
        <li .tag>
          <h3 .tag-name>
            <a href=@{TagR $ tagName tag}>#{pretty tag}
